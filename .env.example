NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXTERNAL_ACTIONS_ENABLED=false

# C9 — Guarded outbound email boundary.
# The guard only opens when BOTH EXTERNAL_ACTIONS_ENABLED=true AND
# VERCEL_ENV=production. Leaving these unset in preview/dev is safe —
# assertGuardedEmailAllowed() throws before touching the provider.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# C10 — Inbound reply webhook.
# `SUPABASE_SERVICE_ROLE_KEY` (NEVER expose client-side) is required by
# createServiceClient() — the webhook runs as service_role because it
# cannot be authenticated as a tenant user. `RESEND_WEBHOOK_SECRET` is
# the Svix signing secret used to verify the inbound-email webhook
# signature; without it, the route returns 503 (fail closed).
SUPABASE_SERVICE_ROLE_KEY=
RESEND_WEBHOOK_SECRET=

# C11 — Reply classification (Claude via Anthropic API).
# ANTHROPIC_API_KEY is optional: if unset, the webhook still ingests and
# emits Attention, but skips classification (returns
# `classification.status: "SKIPPED"` in the response). ANTHROPIC_MODEL
# defaults to `claude-haiku-4-5-20251001`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
