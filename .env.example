# SESIRA — example only. Never commit real values.

# Public application URL
NEXT_PUBLIC_APP_URL=

# Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current Supabase key name used by the core.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only; the runtime accepts this when the publishable key
# has not yet been renamed in an existing Vercel/local environment.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key — never expose as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Safety switch for any external action/automation execution.
EXTERNAL_ACTIONS_ENABLED=false

# Outbound email provider. Leave unset when email sending is not configured.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Inbound Resend/Svix webhook verification. Missing secret makes the webhook fail closed.
RESEND_WEBHOOK_SECRET=

# Optional inbound-reply classification. Without a key, AI classification is skipped.
ANTHROPIC_API_KEY=
# Optional model override; leave blank to use the code default.
ANTHROPIC_MODEL=

# Keep .env.local ignored and real secrets in local/Vercel environment settings.
